# Kopioi tämä tiedostoksi .env ja täytä oikeat arvot

PORT=4000
JWT_SECRET=vaihda-tama-pitkaan-satunnaiseen-merkkijonoon
CORS_ORIGIN=http://localhost:5173

# --- AWS DynamoDB (tietovarasto) ---
# AWS_PROFILE viittaa ~/.aws/credentials -tiedoston profiiliin (ei salasanaa
# tässä tiedostossa - IAM hoitaa tunnistautumisen).
AWS_REGION=eu-north-1
AWS_PROFILE=eam-app
DYNAMODB_TABLE_PREFIX=eam-
